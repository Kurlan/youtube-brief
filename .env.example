# Copy to .env and fill in values from Google Cloud Console.
# Never commit .env - it is gitignored.

# OAuth 2.0 Client ID credentials (Web application) from
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Must exactly match an Authorized redirect URI on the OAuth client.
GOOGLE_REDIRECT_URI=http://localhost:4173/auth/google/callback

# Where the refresh token is persisted after the one-time consent.
# Alternatively set GOOGLE_REFRESH_TOKEN directly (e.g. in production)
# and no token file is needed.
YOUTUBE_TOKEN_FILE=.youtube-tokens.json
GOOGLE_REFRESH_TOKEN=

# Optional: pin the channel to read. Defaults to the authenticated user's own channel.
YOUTUBE_CHANNEL_ID=

PORT=4173
