# Local development defaults; matches docker-compose.yml.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/youtube_brief
PORT=4173
HOST=0.0.0.0

# Object storage for brief images. Unset locally, which stores objects under data/assets/.
# In production these are set by `fly storage create` (plus BUCKET_NAME).
# BUCKET_NAME=
# AWS_REGION=auto
# AWS_ENDPOINT_URL_S3=https://fly.storage.tigris.dev
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# REVISION_LIMIT=50
# BODY_LIMIT=25mb
